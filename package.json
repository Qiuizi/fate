{
  "name": "fate",
  "private": true,
  "version": "1.0.1",
  "description": "命理排盘 ATELIER — 八字、紫微斗数与易经六爻",
  "author": "Qiuizi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:yijing": "tsx scripts/verify-yijing.ts",
    "desktop": "npm run build && node scripts/launch-electron.mjs",
    "desktop:build": "npm run build && electron-builder --win portable nsis",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:calc": "tsx scripts/verify-calc.ts",
    "test:ai": "tsx scripts/verify-ai-export.ts",
    "gen:ai-skill": "tsx scripts/gen-ai-skill.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:unified": "node scripts/smoke-unified.mjs",
    "test:crosscheck": "tsx scripts/crosscheck/run.ts",
    "crosscheck:gen": "python3 scripts/crosscheck/gen_reference.py",
    "fonts:build": "python3 scripts/fonts/build-fonts.py",
    "export:vbook": "node scripts/export-vbook-longimage.mjs"
  },
  "build": {
    "appId": "com.qiuizi.mingli",
    "productName": "命理排盘",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Mingli-Atelier-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Mingli-Atelier-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "lunar-javascript": "^1.7.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
